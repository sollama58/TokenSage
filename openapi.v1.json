  "info": {
    "description": "Explains what a pump.fun token means, given its contract address. Deterministic analysis of name, ticker, image and linked X/Twitter content.",
    "title": "TokenSage",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/jobs/{job_id}": {
      "get": {
        "operationId": "get_job_v1_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Poll an analysis job",
        "tags": [
          "v1"
        ]
      }
    },
    "/v1/meta": {
      "get": {
        "operationId": "meta_v1_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Versions, taxonomy and flag codes",
        "tags": [
          "v1"
        ]
      }
    },
    "/v1/tokens/{ca}": {
      "get": {
        "operationId": "get_token_v1_tokens__ca__get",
        "parameters": [
          {
            "in": "path",
            "name": "ca",
            "required": true,
            "schema": {
              "title": "Ca",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "depth",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "basic",
                    "full"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Depth"
            }
          },
          {
            "in": "query",
            "name": "wait",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 25,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Wait"
            }
          },
          {
            "in": "query",
            "name": "max_age",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 604800,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max Age"
            }
          },
          {
            "in": "query",
            "name": "refresh",
            "required": false,
            "schema": {
              "default": false,
              "title": "Refresh",
              "type": "boolean"
            }
          },
          {
            "description": "comma list of optional parts to keep: evidence, raw. Omit to get everything; a part left out of the list is dropped (evidence -> [], raw -> empty)",
            "in": "query",
            "name": "include",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "comma list of optional parts to keep: evidence, raw. Omit to get everything; a part left out of the list is dropped (evidence -> [], raw -> empty)",
              "title": "Include"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Analysis pending; poll again."
          },
          "400": {
            "description": "invalid_ca"
          },
          "401": {
            "description": "unauthorized"
          },
          "404": {
            "description": "token_not_found"
          },
          "422": {
            "description": "not_a_token_mint | not_pumpfun"
          },
          "429": {
            "description": "rate_limited"
          },
          "503": {
            "description": "overloaded"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Analyze a pump.fun token by contract address",
        "tags": [
          "v1"
        ]
      }
    },
    "/v1/tokens:batch": {
      "post": {
        "operationId": "batch_v1_tokens_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
