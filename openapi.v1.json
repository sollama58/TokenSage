                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Prefetch up to 50 CAs",
        "tags": [
          "v1"
        ]
      }
    }
  }
